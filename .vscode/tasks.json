{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Update MSYS2",
      "type": "process",
      "command": "cmd.exe",
      "args": [
        "/d",
        "/c",
        "msys2_shell.cmd",
        "-ucrt64",
        "-defterm",
        "-no-start",
        "-here",
        "-c",
        "pacman -Syu"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "close": false
      },
      "problemMatcher": []
    },
    {
      "label": "Install Build Dependencies",
      "type": "process",
      "command": "cmd.exe",
      "args": [
        "/d",
        "/c",
        "msys2_shell.cmd",
        "-ucrt64",
        "-defterm",
        "-no-start",
        "-here",
        "-c",
        "pacman -S --needed mingw-w64-ucrt-x86_64-gcc mingw-w64-ucrt-x86_64-cmake mingw-w64-ucrt-x86_64-ninja mingw-w64-ucrt-x86_64-pkgconf mingw-w64-ucrt-x86_64-glfw"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "close": false
      },
      "problemMatcher": []
    },
    {
      "label": "CMake: Configure",
      "type": "process",
      "command": "cmd.exe",
      "args": [
        "/d",
        "/c",
        "msys2_shell.cmd",
        "-ucrt64",
        "-defterm",
        "-no-start",
        "-here",
        "-c",
        "cmake --preset default"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "close": false
      },
      "problemMatcher": []
    },
    {
      "label": "Build Engine",
      "type": "process",
      "command": "cmd.exe",
      "args": [
        "/d",
        "/c",
        "msys2_shell.cmd",
        "-ucrt64",
        "-defterm",
        "-no-start",
        "-here",
        "-c",
        "cmake --preset default && cmake --build --preset default"
      ],
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "close": false
      },
      "problemMatcher": []
    },
    {
      "label": "Run Engine",
      "type": "process",
      "command": "cmd.exe",
      "args": [
        "/d",
        "/c",
        "msys2_shell.cmd",
        "-ucrt64",
        "-defterm",
        "-no-start",
        "-here",
        "-c",
        "./build/Engine.exe"
      ],
      "dependsOn": "Build Engine",
      "dependsOrder": "sequence",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "close": false
      },
      "problemMatcher": []
    }
  ]
}
