{
  "version": "2.0.0",
  "tasks": [
    { // MSYS SETUP
      "label": "MSYS2: Set Up Environment",
      "dependsOn": [
        "MSYS2: Update",
        "MSYS2: Install UCRT64 Dependencies",
        "MSYS2: Install OpenGL Dependencies"
      ],
      "dependsOrder": "sequence"
    },
    { // MSYS UPDATE
      "label": "MSYS2: Update",
      "type": "shell",
      "command": "call \"${config:msys2.root}\\msys2_shell.cmd\" -ucrt64 -defterm -no-start -here -c \"pacman -Syu\"",
      "options": {
        "cwd": "${workspaceFolder}",
        "shell": {
          "executable": "cmd.exe",
          "args": ["/d", "/c"]
        }
      },
      "presentation": {
        "group": "msys2",
        "reveal": "always",
        "panel": "dedicated",
        "close": false
      },
      "problemMatcher": []
    },
    { // MSYS UCRT64 DEPENDENCIES
      "label": "MSYS2: Install UCRT64 Dependencies",
      "type": "shell",
      "command": "call \"${config:msys2.root}\\msys2_shell.cmd\" -ucrt64 -defterm -no-start -here -c \"pacman -S --needed mingw-w64-ucrt-x86_64-gcc mingw-w64-ucrt-x86_64-cmake mingw-w64-ucrt-x86_64-ninja mingw-w64-ucrt-x86_64-pkgconf\"",
      "options": {
        "cwd": "${workspaceFolder}",
        "shell": {
          "executable": "cmd.exe",
          "args": ["/d", "/c"]
        }
      },
      "presentation": {
        "group": "msys2",
        "reveal": "always",
        "panel": "dedicated",
        "close": false
      },
      "problemMatcher": []
    },
    { // MSYS2 OPENGL DEPENDENCIES
      "label": "MSYS2: Install OpenGL Dependencies",
      "type": "shell",
      "command": "call \"${config:msys2.root}\\msys2_shell.cmd\" -ucrt64 -defterm -no-start -here -c \"pacman -S --needed mingw-w64-ucrt-x86_64-glfw mingw-w64-ucrt-x86_64-glm mingw-w64-ucrt-x86_64-python-glad mingw-w64-ucrt-x86_64-glslang\"",
      "options": {
        "cwd": "${workspaceFolder}",
        "shell": {
          "executable": "cmd.exe",
          "args": ["/d", "/c"]
        }
      },
      "presentation": {
        "group": "msys2",
        "reveal": "always",
        "panel": "dedicated",
        "close": false
      },
      "problemMatcher": []
    },
    { // MSYS2 GENERATE GLAD
      "label": "MSYS2: Generate GLAD",
      "type": "shell",
      "command": "call \"${config:msys2.root}\\msys2_shell.cmd\" -ucrt64 -defterm -no-start -here -c \"glad --api gl:core=3.3 --out-path third_party/glad c --loader\"",
      "options": {
        "cwd": "${workspaceFolder}",
        "shell": {
          "executable": "cmd.exe",
          "args": ["/d", "/c"]
        }
      },
      "presentation": {
        "group": "msys2",
        "reveal": "always",
        "panel": "dedicated",
        "close": false
      },
      "problemMatcher": []
    },
    {
      "label": "MSYS2: Sync CMake Tools Paths",
      "type": "process",
      "command": "powershell.exe",
      "args": [
        "-NoProfile",
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "${workspaceFolder}\\.vscode\\sync-msys2-cmake-settings.ps1",
        "-Msys2Root",
        "${config:msys2.root}"
      ],
      "problemMatcher": []
    },
    { // CMAKE CONFIG
      "label": "CMake: Configure",
      "type": "cmake",
      "command": "configure",
      "preset": "default",
      "problemMatcher": []
    },
    { // CMAKE BUILD
      "label": "CMake: Build",
      "type": "cmake",
      "command": "build",
      "preset": "default",
      "dependsOn": "CMake: Configure",
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": []
    },
    { // CMAKE TEST
      "label": "CMake: Run Tests",
      "type": "cmake",
      "command": "test",
      "preset": "default",
      "dependsOn": "CMake: Build",
      "problemMatcher": []
    },
    { // RUN ENGINE
      "label": "Run Engine",
      "type": "process",
      "command": "${command:cmake.launchTargetPath}",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "dependsOn": "CMake: Build",
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "close": false
      },
      "problemMatcher": []
    }
  ]
}
